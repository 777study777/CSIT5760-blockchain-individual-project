# Copy to `.env` and fill in. Never commit the real file.
# Sepolia RPC endpoint, e.g. from Alchemy / Infura / a public node.
SEPOLIA_RPC_URL=

# Deployer private key. Use a throw-away testnet-only account, never a mainnet key.
PRIVATE_KEY=

# Etherscan API key, only needed for `hardhat verify`.
ETHERSCAN_API_KEY=
